---
/**
 * Blog index for one locale. Rendered by src/pages/blog/index.astro and
 * src/pages/[lang]/blog/index.astro.
 */
import PageLayout from '@/layouts/PageLayout.astro';
import PageHero from '@/components/blocks/PageHero.astro';
import Band from '@/components/blocks/Band.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import NewsletterForm from '@/components/patterns/NewsletterForm.astro';
import MotionInit from '@/components/patterns/MotionInit.astro';
import { localizeRoute, useTranslations, type Locale } from '@/i18n';
import { getPosts, getPostUrl, getPostReadingTime } from '@/lib/blog';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
const homeHref = localizeRoute('home', locale);

const posts = await getPosts(locale);

// Featured posts get their own section; if every post is featured, list them all below too.
const featuredPosts = posts.filter((post) => post.data.featured);
const nonFeaturedPosts = posts.filter((post) => !post.data.featured);
const regularPosts = nonFeaturedPosts.length > 0 ? nonFeaturedPosts : posts;
const regularGridCols =
  regularPosts.length === 1
    ? 'mx-auto max-w-2xl grid-cols-1'
    : regularPosts.length === 2
      ? 'md:grid-cols-2'
      : 'md:grid-cols-2 lg:grid-cols-3';
---

<PageLayout title={t('blogPage.heroTitle')} description={t('blogPage.heroLead')}>
  <MotionInit />

  <PageHero
    tone="secondary"
    eyebrow={t('blogPage.heroEyebrow')}
    title={t('blogPage.heroTitle')}
    lead={t('blogPage.heroLead')}
    class="negonex-page-hero"
  >
    <Breadcrumbs
      slot="breadcrumbs"
      items={[{ label: t('nav.home'), href: homeHref }, { label: t('nav.guides') }]}
    />
  </PageHero>

  {
    featuredPosts.length > 0 && (
      <Band
        centered
        data-reveal=""
        eyebrow={t('blogPage.featuredEyebrow')}
        eyebrowClass="negonex-eyebrow text-xs font-bold uppercase"
        title={t('blog.featured')}
      >
        <div
          class={`grid gap-6 ${featuredPosts.length === 1 ? 'mx-auto max-w-2xl grid-cols-1' : 'md:grid-cols-2'}`}
          data-reveal-stagger=""
        >
          {featuredPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              readingTime={getPostReadingTime(post)}
              href={getPostUrl(post)}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              author={post.data.author}
              image={post.data.image}
              featured={true}
              class="card-interactive"
            />
          ))}
        </div>
      </Band>
    )
  }

  <Band
    tone={featuredPosts.length > 0 ? 'secondary' : 'default'}
    centered
    data-reveal=""
    eyebrow={t('blogPage.allEyebrow')}
    eyebrowClass="negonex-eyebrow text-xs font-bold uppercase"
    title={t('blog.allPosts')}
  >
    {
      regularPosts.length > 0 ? (
        <div class={`grid gap-6 ${regularGridCols}`} data-reveal-stagger="">
          {regularPosts.map((post) => (
            <BlogCard
              title={post.data.title}
              description={post.data.description}
              readingTime={getPostReadingTime(post)}
              href={getPostUrl(post)}
              publishedAt={post.data.publishedAt}
              tags={post.data.tags}
              author={post.data.author}
              image={post.data.image}
              class="card-interactive"
            />
          ))}
        </div>
      ) : (
        <div class="py-12 text-center">
          <div class="bg-card border-border mx-auto mb-4 flex size-16 items-center justify-center rounded-full border">
            <Icon name="file-text" size="lg" class="text-foreground-muted" />
          </div>
          <p class="text-foreground text-lg font-medium">{t('blog.noPosts')}</p>
          <p class="text-foreground-muted mt-1">{t('blog.noPostsHint')}</p>
        </div>
      )
    }
  </Band>

  <Band
    tone="invert"
    centered
    pad="sm"
    data-reveal=""
    eyebrow={t('blogPage.newsletterEyebrow')}
    eyebrowClass="negonex-eyebrow text-xs font-bold uppercase"
    title={t('blog.subscribeTitle')}
    lead={t('blog.subscribeText')}
  >
    <NewsletterForm class="mx-auto max-w-md" />
  </Band>
</PageLayout>
