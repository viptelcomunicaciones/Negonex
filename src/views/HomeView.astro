---

<PageLayout title={t('meta.home.title')} description={t('meta.home.description')}>
  <MotionInit />
  <JsonLd schema={createOrganizationSchema()} />

  <Hero layout="split" size="md" class="negonex-hero" data-pause-offscreen="">
    <Badge slot="badge" variant="brand" pill>
      {t('home.hero.badge')}
    </Badge>

    <h1 slot="title" class="negonex-h1">
      {t('home.hero.title')}{' '}
      <span class="text-brand-600 dark:text-brand-400">{t('home.hero.titleHighlight')}</span>
    </h1>

    <p slot="description">{t('home.hero.lead')}</p>

    <Fragment slot="actions">
      <Button variant="brand" size="lg" trailingIcon="arrow-down" href="#sandbox">
        {t('home.hero.primaryCta')}
      </Button>
      <Button variant="outline" size="lg" trailingIcon="arrow-right" href={contactHref}>
        {t('home.hero.secondaryCta')}
      </Button>
    </Fragment>

    <aside slot="aside" class="bg-card border-border rounded-2xl border p-6 shadow-md">
      <div class="border-border border-b pb-4">
        <h2 class="font-display text-foreground text-lg font-bold">{t('home.hero.asideTitle')}</h2>
        <p class="text-foreground-muted mt-1 text-sm">{t('home.hero.asideSubtitle')}</p>
      </div>
      <ol class="divide-border divide-y">
        {
          pipelineRows.map((row) => (
            <li class="pipeline-step flex items-start gap-3 py-3.5">
              <div class="bg-brand-50 dark:bg-brand-900/30 text-brand-700 dark:text-brand-300 mt-0.5 rounded-lg p-2">
                <Icon name={row.icon} size="sm" />
              </div>
              <div class="min-w-0 flex-1">
                <p class="text-foreground flex items-center gap-2 text-xs font-semibold tracking-wide uppercase">
                  <span class="pipeline-dot bg-brand-500 inline-block h-2 w-2 shrink-0 rounded-full" aria-hidden="true" />
                  <span>{row.label}</span>
                </p>
                <p class="text-foreground-secondary mt-0.5 text-sm leading-snug">{row.value}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </aside>
  </Hero>

  <AnimatedStatsBand
    tone="secondary"
    pad="sm"
    stats={[
      {
        value: t('home.stats.languagesValue'),
        label: t('home.stats.languagesLabel'),
        countTo: 95,
        prefix: locale === 'es' ? '+' : '',
        suffix: locale === 'en' ? '+' : '',
      },
      {
        value: t('home.stats.slaValue'),
        label: t('home.stats.slaLabel'),
        countTo: 99.9,
        suffix: '%',
        decimals: 1,
      },
      { value: t('home.stats.availabilityValue'), label: t('home.stats.availabilityLabel') },
      { value: t('home.stats.deploymentValue'), label: t('home.stats.deploymentLabel') },
    ]}
  />

  <Band
    centered
    data-reveal=""
    eyebrow={t('home.valuePillars.eyebrow')}
    eyebrowClass="negonex-eyebrow text-xs font-bold uppercase"
    title={t('home.valuePillars.title')}
    lead={t('home.valuePillars.lead')}
  >
    <FeatureGrid
      bare
      columns={2}
      variant="card"
      class="negonex-reveal-cards negonex-interactive-cards"
      items={[
        { icon: 'languages', title: t('home.valuePillars.p1Title'), body: t('home.valuePillars.p1Body') },
        { icon: 'plug-zap', title: t('home.valuePillars.p2Title'), body: t('home.valuePillars.p2Body') },
        { icon: 'clock', title: t('home.valuePillars.p3Title'), body: t('home.valuePillars.p3Body') },
        { icon: 'shield-check', title: t('home.valuePillars.p4Title'), body: t('home.valuePillars.p4Body') },
      ]}
    />
  </Band>

  <Band id="sandbox" tone="secondary" width="wide" centered data-reveal="">
    <InterculturalSandbox client:visible labels={sandboxLabels} scenarios={scenarios} />
  </Band>

  <Band
    centered
    data-reveal=""
    eyebrow={t('home.steps.eyebrow')}
    eyebrowClass="negonex-eyebrow text-xs font-bold uppercase"
    title={t('home.steps.title')}
    lead={t('home.steps.lead')}
  >
    <Steps
      bare
      layout="row"
      class="negonex-steps"
      data-reveal-stagger=""
      items={[
        { title: t('home.steps.s1Title'), body: t('home.steps.s1Body') },
        { title: t('home.steps.s2Title'), body: t('home.steps.s2Body') },
        { title: t('home.steps.s3Title'), body: t('home.steps.s3Body') },
        { title: t('home.steps.s4Title'), body: t('home.steps.s4Body') },
      ]}
    />
  </Band>

  <Pricing
    tone="secondary"
    eyebrow={t('home.pricingPreview.eyebrow')}
    title={t('home.pricingPreview.title')}
    lead={t('home.pricingPreview.lead')}
    note={t('home.pricingPreview.note')}
    class="negonex-reveal-cards negonex-interactive-cards"
    plans={[
      {
        name: t('home.pricingPreview.starterName'),
        price: t('home.pricingPreview.starterPrice'),
        period: t('home.pricingPreview.starterPeriod'),
        badge: t('home.pricingPreview.starterBadge'),
        description: t('home.pricingPreview.starterDesc'),
        features: [
          t('home.pricingPreview.starterF1'),
          t('home.pricingPreview.starterF2'),
          t('home.pricingPreview.starterF3'),
          t('home.pricingPreview.starterF4'),
        ],
        cta: { label: t('home.pricingPreview.starterCta'), href: pricingHref },
      },
      {
        name: t('home.pricingPreview.enterpriseName'),
        price: t('home.pricingPreview.enterprisePrice'),
        period: t('home.pricingPreview.enterprisePeriod'),
        badge: t('home.pricingPreview.enterpriseBadge'),
        highlighted: true,
        description: t('home.pricingPreview.enterpriseDesc'),
        features: [
          t('home.pricingPreview.enterpriseF1'),
          t('home.pricingPreview.enterpriseF2'),
          t('home.pricingPreview.enterpriseF3'),
          t('home.pricingPreview.enterpriseF4'),
        ],
        cta: { label: t('home.pricingPreview.enterpriseCta'), href: pricingHref },
      },
    ]}
  />

  <Band
    tone="invert"
    centered
    data-reveal=""
    eyebrow={t('home.securityBand.eyebrow')}
    eyebrowClass="negonex-eyebrow text-xs font-bold uppercase"
    title={t('home.securityBand.title')}
    lead={t('home.securityBand.lead')}
  >
    <div class="grid grid-cols-1 gap-6 md:grid-cols-3" data-reveal-stagger="">
      <div class="border-border-invert card-interactive rounded-xl border p-6">
        <span class="bg-brand-500/15 text-brand-400 mb-4 grid size-10 place-items-center rounded-lg">
          <Icon name="server" size="md" />
        </span>
        <h3 class="font-display text-on-invert text-lg font-semibold">{t('home.securityBand.item1Title')}</h3>
        <p class="text-on-invert-muted mt-2 text-sm leading-relaxed">{t('home.securityBand.item1Body')}</p>
      </div>
      <div class="border-border-invert card-interactive rounded-xl border p-6">
        <span class="bg-brand-500/15 text-brand-400 mb-4 grid size-10 place-items-center rounded-lg">
          <Icon name="lock" size="md" />
        </span>
        <h3 class="font-display text-on-invert text-lg font-semibold">{t('home.securityBand.item2Title')}</h3>
        <p class="text-on-invert-muted mt-2 text-sm leading-relaxed">{t('home.securityBand.item2Body')}</p>
      </div>
      <div class="border-border-invert card-interactive rounded-xl border p-6">
        <span class="bg-brand-500/15 text-brand-400 mb-4 grid size-10 place-items-center rounded-lg">
          <Icon name="file-check" size="md" />
        </span>
        <h3 class="font-display text-on-invert text-lg font-semibold">{t('home.securityBand.item3Title')}</h3>
        <p class="text-on-invert-muted mt-2 text-sm leading-relaxed">{t('home.securityBand.item3Body')}</p>
      </div>
    </div>
    <div class="mt-8 flex justify-center">
      <Button variant="outline" href={platformHref} trailingIcon="arrow-right">
        {t('home.securityBand.linkLabel')}
      </Button>
    </div>
  </Band>

  <CtaBand
    tone="brand"
    eyebrow={t('home.cta.eyebrow')}
    title={t('home.cta.title')}
    lead={t('home.cta.lead')}
    data-reveal=""
  >
    <Button variant="primary" size="lg" href={contactHref} trailingIcon="arrow-right">
      {t('home.cta.primary')}
    </Button>
    <Button variant="outline" size="lg" href={pricingHref}>
      {t('home.cta.secondary')}
    </Button>
  </CtaBand>
</PageLayout>

<style is:global>
  .negonex-hero div > h1.negonex-h1 {
    font-size: clamp(2rem, 3.2vw, 3.125rem);
    line-height: 1.12;
  }
</style>
