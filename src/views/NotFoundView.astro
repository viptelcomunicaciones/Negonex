---
import LandingLayout from '@/layouts/LandingLayout.astro';
import Button from '@/components/ui/form/Button/Button.astro';
import Icon from '@/components/ui/primitives/Icon/Icon.astro';
import { getNavItems } from '@/config/nav.config';
import { getLocale, localizePath, localizeRoute, useTranslations } from '@/i18n';

// With several locales this page renders on demand (integrations/localized-404.mjs),
// so the locale comes from the URL that was requested.
const locale = getLocale(Astro);
const t = useTranslations(locale);

// Quick links come from the nav config, so they always point at pages that exist.
const quickLinks = getNavItems()
  .filter((item) => item.route && item.route !== 'blog')
  .slice(0, 3)
  .map((item) => ({ label: t(item.label), href: localizeRoute(item.route!, locale) }));
---

<LandingLayout
  title={t('notFound.title')}
  description={t('notFound.text')}
  noindex
>
  <section class="relative flex min-h-[calc(100dvh-8rem)] items-center justify-center overflow-hidden pt-16">
    <!-- Background Effects -->
    <div class="bg-grid-pattern pointer-events-none absolute inset-0 [mask-image:radial-gradient(ellipse_at_center,white_20%,transparent_70%)] opacity-40"></div>

    <div class="container relative px-6">
      <div class="mx-auto max-w-2xl text-center">
        <!-- Animated 404 -->
        <div class="relative mb-8">
          <div class="error-code font-display leading-none font-bold tracking-tighter select-none">
            <span class="error-digit inline-block">4</span>
            <span class="error-digit text-brand-600 dark:text-brand-400 inline-block">0</span>
            <span class="error-digit inline-block">4</span>
          </div>
        </div>

        <!-- Copy -->
        <h1 class="font-display text-foreground mb-4 text-2xl font-bold text-balance md:text-3xl">
          {t('notFound.heading')}
        </h1>

        <p class="text-foreground-muted mx-auto mb-10 max-w-md text-lg text-pretty">
          {t('notFound.text')}
        </p>

        <!-- CTAs -->
        <div class="mb-12 flex flex-col items-center justify-center gap-4 sm:flex-row">
          <Button href={localizeRoute('home', locale)} variant="brand" size="lg">
            <Icon name="arrow-left" size="sm" />
            {t('notFound.backHome')}
          </Button>
          <Button href={localizePath('/blog', locale)} variant="outline" size="lg">
            {t('notFound.browseBlog')}
          </Button>
        </div>

        <!-- Quick Links -->
        {quickLinks.length > 0 && (
          <nav aria-label={t('notFound.quickLinks')} class="bg-secondary/50 border-border inline-flex flex-wrap items-center justify-center gap-2 rounded-full border px-4 py-2">
            <span class="text-foreground-muted text-sm">{t('notFound.quickLinks')}</span>
            {quickLinks.map((link, i) => (
              <>
                {i > 0 && <span class="text-foreground-subtle" aria-hidden="true">|</span>}
                <a href={link.href} class="text-foreground hover:text-brand-600 dark:hover:text-brand-400 text-sm font-medium transition-colors">
                  {link.label}
                </a>
              </>
            ))}
          </nav>
        )}
      </div>
    </div>
  </section>
</LandingLayout>

<style>
  .error-code {
    color: var(--foreground);
    opacity: 0.16;
    font-size: clamp(8rem, 24vw, 15rem);
  }

  .error-digit {
    animation: float 3.2s cubic-bezier(0.77, 0, 0.175, 1) infinite;
  }

  .error-digit:nth-child(1) {
    animation-delay: 0s;
  }

  .error-digit:nth-child(2) {
    opacity: 1;
    animation-delay: 0.12s;
  }

  .error-digit:nth-child(3) {
    animation-delay: 0.24s;
  }

  @keyframes float {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-8px);
    }
  }

  :global(.dark) .error-code {
    opacity: 0.12;
  }

  :global(.dark) .error-digit:nth-child(2) {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .error-digit {
      animation: none;
    }
  }
</style>
