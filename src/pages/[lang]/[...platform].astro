---
import PlatformView from '@/views/PlatformView.astro';
import { getLocalizedStaticPaths, type Locale } from '@/i18n';

export function getStaticPaths() {
  return getLocalizedStaticPaths('platform', 'platform');
}

const { locale } = Astro.props as { locale: Locale };
---

<PlatformView locale={locale} />
